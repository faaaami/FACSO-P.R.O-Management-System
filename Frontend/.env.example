# Copy to .env.local for local overrides. Never commit real values.

# Base URL of the API as seen by the browser. Leave unset to call the API
# same-origin at /api/v1 (Vite dev proxy locally, reverse proxy in production).
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Development only: where the Vite dev server forwards /api requests.
# VITE_DEV_API_PROXY_TARGET=https://localhost:7280
