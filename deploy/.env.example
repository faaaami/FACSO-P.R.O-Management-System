# Copy to ../.env (next to docker-compose.yml). Never commit the real file.

PUBLIC_URL=https://pro.example.ae

POSTGRES_PASSWORD=change-me-long-random
REDIS_PASSWORD=change-me-long-random
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.ae

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local = on-server OCR (MRZ + Tesseract). Mock = no OCR.
EXTRACTION_PROVIDER=Local

# First start only: creates the first Admin (must change password at first
# sign-in). Remove both after the first successful start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
