{
  "//": "Placeholders only. Never put real values in this file. Every <...> value must be supplied by an environment variable (see README.md); the app refuses to start while any placeholder remains.",

  "ConnectionStrings": {
    "DefaultConnection": "<set ConnectionStrings__DefaultConnection>",
    "Redis": "<set ConnectionStrings__Redis>"
  },

  "App": {
    "FrontendBaseUrl": "<set App__FrontendBaseUrl>"
  },

  "Cors": {
    "AllowedOrigins": [ "<set Cors__AllowedOrigins__0>" ]
  },

  "Jwt": {
    "Secret": "<set Jwt__Secret>"
  },

  "Smtp": {
    "Host": "<set Smtp__Host>",
    "FromAddress": "<set Smtp__FromAddress>"
  },

  "Razorpay": {
    "KeyId": "<set Razorpay__KeyId>",
    "KeySecret": "<set Razorpay__KeySecret>",
    "WebhookSecret": "<set Razorpay__WebhookSecret>"
  },

  "Storage": {
    "RootPath": "<set Storage__RootPath>"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
