{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=PROManagementSystemDb;Username=postgres;Password=YOUR_DB_PASSWORD",
    "Redis": "localhost:6379"
  },

  "RenewalAutomation": {
    "UserId": "00000000-0000-0000-0000-0000000000aa"
  },

  "Jwt": {
    "Secret": "YOUR_JWT_SECRET",
    "Issuer": "PROManagementSystem",
    "Audience": "PROManagementSystem.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Razorpay": {
    "KeyId": "YOUR_RAZORPAY_KEY_ID",
    "KeySecret": "YOUR_RAZORPAY_KEY_SECRET",
    "WebhookSecret": "YOUR_RAZORPAY_WEBHOOK_SECRET"
  },

  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },

  "Storage": {
    "RootPath": "storage"
  },

  "Extraction": {
    "Provider": "Mock",
    "Language": "eng",
    "MaximumPixels": 40000000,
    "MaximumOcrPages": 20,
    "RenderDpi": 300,
    "MaxConcurrentOcr": 2,
    "OcrTimeoutSeconds": 60,
    "OpenRouter": {
      "Endpoint": "",
      "Model": "",
      "MaxTokens": 2048,
      "RequestTimeoutSeconds": 60,
      "MaxRetries": 2,
      "MaxInputCharacters": 20000,
      "MaxResponseBytes": 1048576
    }
  },

  "AllowedHosts": "*"
}
