{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=PROManagementSystemDb;Username=postgres",
    "Redis": "localhost:6379"
  },

  "App": {
    "FrontendBaseUrl": "http://localhost:5173"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "Storage": {
    "RootPath": "storage"
  },

  "Extraction": {
    "Provider": "Mock",
    "Language": "eng",
    "MaximumPixels": 40000000,
    "MaximumOcrPages": 20,
    "RenderDpi": 300,
    "MaxConcurrentOcr": 2,
    "OcrTimeoutSeconds": 60
  }
}
