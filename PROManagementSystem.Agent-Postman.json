{
  "info": {
    "name": "PRO Management System - Agent API",
    "description": "Agent-scoped endpoints for the PRO Management System. Covers Authentication, Tasks (status machine), Clients, Entities, Employees, Documents, Notifications, and Account. Access is strictly task-linked: an agent can only see resources belonging to renewal tasks assigned to them. JWT bearer auth is required on all Agent endpoints.\n\nSetup:\n1. Set the baseUrl variable (default http://localhost:5000).\n2. Run 'Agent Login' (or 'Admin Login') to obtain a token; the test script stores it in the agentToken/adminToken variables.\n3. Collection-level bearer auth uses the agentToken variable. To run with admin/client tokens, override the Authorization header or pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{agentToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "agentToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "clientToken", "value": "" },
    { "key": "agentId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "clientId", "value": "" },
    { "key": "entityId", "value": "" },
    { "key": "employeeId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "extractionId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Agent Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@example.com\",\n  \"password\": \"AgentPass!123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json().data || pm.response.json();",
                  "pm.collectionVariables.set('agentToken', body.accessToken || body.token || body);",
                  "pm.collectionVariables.set('agentId', (body.user && body.user.id) || body.userId || '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminPass!123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json().data || pm.response.json();",
                  "pm.collectionVariables.set('adminToken', body.accessToken || body.token || body);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List My Tasks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/agent/tasks?status=&page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agent", "tasks"],
              "query": [
                { "key": "status", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json().data || pm.response.json();",
                  "const items = body.items || body.tasks || (Array.isArray(body) ? body : []);",
                  "if (items && items.length) { pm.collectionVariables.set('taskId', items[0].id || items[0].taskId || ''); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Task",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/agent/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agent", "tasks", "{{taskId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get task returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Task belongs to agent (scope check)', () => {",
                  "  const body = pm.response.json().data || pm.response.json();",
                  "  pm.expect(body).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task Status (sequential)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"FeePaid\",\n  \"note\": \"Fee confirmed by agent\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/agent/tasks/{{taskId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agent", "tasks", "{{taskId}}", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status update returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task Status (skip - expect 409)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Approved\",\n  \"note\": \"Attempting to skip stages\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/agent/tasks/{{taskId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agent", "tasks", "{{taskId}}", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Out-of-sequence transition returns 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Block Task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blockedReason\": \"Awaiting client documents\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/agent/tasks/{{taskId}}/block",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agent", "tasks", "{{taskId}}", "block"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Block returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unassigned Task Returns 404",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/agent/tasks/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agent", "tasks", "00000000-0000-0000-0000-000000000000"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Task not owned by agent returns 404 (scope leak guard)', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
